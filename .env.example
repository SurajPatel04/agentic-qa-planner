# ---------------------------------------------------------
# Backend Environment Variables (Place in backend/.env)
# ---------------------------------------------------------

APP_NAME="Agentic QA Planning Assistant"
DEBUG=True
PUBLIC_BASE_URL="http://localhost:8000"

# CORS
# Comma-separated list of allowed origins. Be sure to include your frontend port (e.g. 5173 for Vite)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost/agentic_qa"

# API Keys
# OpenAI API key is required for the LLM agents and FAISS embeddings
OPENAI_API_KEY="sk-proj-..."

# ---------------------------------------------------------
# Frontend Environment Variables (Place in frontend/.env)
# ---------------------------------------------------------

# Base URL for the backend API
VITE_API_BASE_URL="http://localhost:8000"
