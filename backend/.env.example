# App Settings
APP_NAME="Agentic QA Planning Assistant"
DEBUG=True
PUBLIC_BASE_URL="http://localhost:8000"

# CORS
# Comma-separated list of allowed origins (e.g., your frontend URL)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost/agentic_qa"

# API Keys
# OpenAI API key is required for the LLM agents and embeddings
OPENAI_API_KEY="sk-proj-..."
